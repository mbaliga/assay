{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assay.dev/schemas/1.1.0/candidate.schema.json",
  "title": "Assay Fix Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "revision", "lifecycle", "events", "proofDigest", "approval", "application"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "sourceRepo", "sourceCommit", "findingFingerprint", "provingId", "patchDigest", "testDigest", "fixBranch"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/candidateId" },
        "sourceRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "sourceCommit": { "$ref": "#/$defs/sha1" },
        "findingFingerprint": { "$ref": "#/$defs/sha256" },
        "provingId": { "type": "string", "pattern": "^pt1-(gitleaks|semgrep|osv|mobsf)-[a-z0-9-]{1,40}-[0-9a-f]{16}$" },
        "patchDigest": { "$ref": "#/$defs/sha256" },
        "testDigest": { "$ref": "#/$defs/sha256" },
        "fixBranch": { "type": "string", "pattern": "^assay/fix/cand1-[0-9a-f]{20}$" }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "state", "occurredAt", "actor", "evidenceDigest", "previousEventDigest", "eventDigest"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "state": { "$ref": "#/$defs/lifecycle" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "pattern": "^(system|human):[A-Za-z0-9._@+-]{1,128}$" },
          "evidenceDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
          "previousEventDigest": { "$ref": "#/$defs/sha256" },
          "eventDigest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "proofDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor", "approvedAt", "proofDigest", "candidateRevision", "approvalDigest"],
          "properties": {
            "actor": { "type": "string", "pattern": "^human:[A-Za-z0-9._@+-]{1,128}$" },
            "approvedAt": { "type": "string", "format": "date-time" },
            "proofDigest": { "$ref": "#/$defs/sha256" },
            "candidateRevision": { "type": "integer", "minimum": 1 },
            "approvalDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "application": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor", "appliedAt", "sourceCommit", "fixCommit", "fixBranch", "approvalDigest"],
          "properties": {
            "actor": { "type": "string", "pattern": "^(system|human):[A-Za-z0-9._@+-]{1,128}$" },
            "appliedAt": { "type": "string", "format": "date-time" },
            "sourceCommit": { "$ref": "#/$defs/sha1" },
            "fixCommit": { "$ref": "#/$defs/sha1" },
            "fixBranch": { "type": "string", "pattern": "^assay/fix/cand1-[0-9a-f]{20}$" },
            "approvalDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateId": { "type": "string", "pattern": "^cand1-[0-9a-f]{20}$" },
    "lifecycle": {
      "enum": ["detected", "proposed", "proof_passed", "proof_failed", "approved", "rejected", "applied", "stale", "superseded", "withdrawn", "obsolete"]
    }
  }
}
